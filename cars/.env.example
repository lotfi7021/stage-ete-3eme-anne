APP_NAME=Laravel

# En production : APP_ENV=production et APP_DEBUG=false (ne jamais exposer de stack trace).
# En développement local : APP_ENV=local / APP_DEBUG=true.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=selectcars
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Sessions en base (table `sessions`) : purge automatique par la loterie Laravel.
SESSION_DRIVER=database
SESSION_LIFETIME=60

# Chiffrement du contenu de session (nécessite APP_KEY).
SESSION_ENCRYPT=true

# ── Durcissement du cookie de session ──
# http_only=true et same_site=lax sont fixés dans config/session.php.
# SESSION_SECURE_COOKIE=true exige un site servi en HTTPS (production).
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Mots de passe des comptes créés par le seeder ──
# Laisser vide pour générer un mot de passe aléatoire (affiché lors du seed).
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=
SEED_LIVREUR_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
